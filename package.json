{
  "name": "pos-rfid-system",
  "version": "1.0.0",
  "description": "Multi-location retail POS + RFID inventory management system",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node server/index.js",
    "build": "npm --prefix client install --no-audit --no-fund && npm --prefix client run build",
    "migrate": "node server/db/migrate.js",
    "seed": "node server/db/seed.js",
    "reset": "node server/db/migrate.js --fresh && node server/db/seed.js",
    "dev:server": "node --watch server/index.js",
    "dev:client": "npm --prefix client run dev",
    "test": "node scripts/e2e.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.12.0",
    "xlsx": "^0.18.5"
  }
}
