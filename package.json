{
  "name": "pos-rfid-system",
  "version": "5.0.0",
  "description": "Multi-location retail POS + RFID inventory management system",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/index.js",
    "build": "node scripts/check-refs.mjs && npm --prefix client install --no-audit --no-fund && npm --prefix client run build",
    "migrate": "node server/db/migrate.js",
    "reset": "node server/db/migrate.js --fresh && node server/db/bootstrap.js",
    "dev:server": "node --watch server/index.js",
    "dev:client": "npm --prefix client run dev",
    "test": "node scripts/e2e.js",
    "check": "node scripts/check-refs.mjs",
    "bootstrap": "node server/db/bootstrap.js",
    "fixtures": "ALLOW_DEMO_DATA=1 node scripts/demo-fixtures.js",
    "reset:test": "node server/db/migrate.js --fresh && node server/db/bootstrap.js && ALLOW_DEMO_DATA=1 node scripts/demo-fixtures.js",
    "check:ui": "node scripts/ui-check.mjs",
    "check:empty": "node scripts/empty-state-check.mjs",
    "check:sweep": "node scripts/sweep-check.mjs",
    "check:reader": "node scripts/reader-test-check.mjs",
    "check:commit": "node scripts/commit-delivery-check.mjs",
    "check:native": "node scripts/native-bridge-check.mjs",
    "android": "npm --prefix android-app run sync",
    "android:apk": "npm --prefix android-app run apk",
    "apk": "bash android-native/build.sh"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.12.0",
    "qrcode": "^1.5.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}
