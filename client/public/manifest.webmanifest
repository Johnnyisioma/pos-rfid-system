{
  "name": "Retail POS + RFID Inventory",
  "short_name": "POS RFID",
  "description": "Multi-location point of sale and RFID stock control",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#0f172a",
  "theme_color": "#0f172a",
  "categories": ["business", "productivity", "shopping"],
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "New sale", "short_name": "Sell", "url": "/pos" },
    { "name": "Stock Take Mode", "short_name": "Stock take", "url": "/stock-take-mode" },
    { "name": "Scan a tag", "short_name": "Scan", "url": "/rfid/scan" }
  ]
}
