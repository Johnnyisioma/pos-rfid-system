# ───────────────────────────────────────────────────────────────
#  Required
# ───────────────────────────────────────────────────────────────

# PostgreSQL connection string.
# On Railway, add a Postgres database to the project and set this to the
# reference ${{Postgres.DATABASE_URL}} — Railway fills it in automatically.
DATABASE_URL=postgres://user:password@host:5432/posrfid

# Secret used to sign staff login tokens. Use a long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# ───────────────────────────────────────────────────────────────
#  Optional
# ───────────────────────────────────────────────────────────────

# Port the server listens on. Railway sets this for you — leave it unset there.
PORT=3000

# How long a staff session lasts before they must sign in again.
JWT_EXPIRES=12h

# Load the demo catalogue and 60 days of sample sales the first time the
# database is empty. Set to false once you start entering real stock.
SEED_ON_BOOT=true

# Set to false to keep the seed from ever running (belt and braces for production).
# SEED_ON_BOOT=false

# Restrict browser origins allowed to call the API. Leave unset to allow the
# same origin that serves the app (the normal setup).
# CORS_ORIGIN=https://your-shop.up.railway.app

# Force TLS on the Postgres connection when the URL has no sslmode parameter.
# PGSSL=true

# Maximum PostgreSQL connections held by the pool.
# PG_POOL_MAX=10
