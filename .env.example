# ───────────────────────────────────────────────────────────────
#  Required
# ───────────────────────────────────────────────────────────────

# PostgreSQL connection string.
# On Railway, add a Postgres database to the project and set this to the
# reference ${{Postgres.DATABASE_URL}} — Railway fills it in automatically.
DATABASE_URL=postgres://user:password@host:5432/posrfid

# Secret used to sign staff login tokens. Use a long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# ───────────────────────────────────────────────────────────────
#  Optional
# ───────────────────────────────────────────────────────────────

# Port the server listens on. Railway sets this for you — leave it unset there.
PORT=3000

# How long a staff session lasts before they must sign in again.
JWT_EXPIRES=12h

# ───────────────────────────────────────────────────────────────
#  First run
# ───────────────────────────────────────────────────────────────
# On an empty database the server creates a location, a register, an admin
# login and the reference lists — and nothing else. No sample products, stock,
# sales or customers are ever created.
#
# The admin password is generated and printed ONCE in the deploy logs. Set it
# here instead if you would rather choose it yourself.
# ADMIN_EMAIL=you@yourshop.com
# ADMIN_PASSWORD=choose-something-long
# ADMIN_NAME=Your Name

# The first branch, created on first run. Rename it later in Settings.
# LOCATION_NAME=Main Shop
# LOCATION_CODE=MAIN

# Restrict browser origins allowed to call the API. Leave unset to allow the
# same origin that serves the app (the normal setup).
# CORS_ORIGIN=https://your-shop.up.railway.app

# Force TLS on the Postgres connection when the URL has no sslmode parameter.
# PGSSL=true

# Maximum PostgreSQL connections held by the pool.
# PG_POOL_MAX=10
